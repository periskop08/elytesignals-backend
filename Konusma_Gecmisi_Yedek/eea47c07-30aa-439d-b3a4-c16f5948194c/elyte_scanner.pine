//@version=5
indicator("Elyte AI Score Scanner [Periskop]", overlay=true, max_labels_count=100)

// --- A. AYARLAR KISMI (INPUTS) ---
minScore = input.int(40, "Minimum Score Threshold", step=5, group="Periskop Risk Settings")
showBreakdown = input.bool(true, "Skor Dağılımını Göster", group="Periskop Risk Settings")

// --- B. ANA DEĞERLER (VITAL METRICS) ---
atrVal = ta.atr(14)
rangeH = ta.highest(high, 50)
rangeL = ta.lowest(low, 50)
eq = (rangeH + rangeL) / 2

// Yön ve Range Tespiti (Sweep Kondisyonu)
isLongSweep = low <= ta.lowest(low, 15)[1] and close > open and close > high[1]
isShortSweep = high >= ta.highest(high, 15)[1] and close < open and close < low[1]

direction = isLongSweep ? 1 : isShortSweep ? -1 : 0
qualityScore = 0

// --- C. KALİTE PUANI (QUALITY SCORE) MOTORU ---

// 1. ORDER BLOCK (OB) ONAYI (+25 Puan)
var obScore = 0
obScore := 0
if direction == 1
    if close < rangeL + (atrVal * 2) 
        for i = 6 to 30
            if close[i] < open[i] and high[i-1] > high[i]
                obScore := 25
                break
if direction == -1
    if close > rangeH - (atrVal * 2)
        for i = 6 to 30
            if close[i] > open[i] and low[i-1] < low[i]
                obScore := 25
                break
if obScore > 0
    qualityScore += 25

// 2. FVG (FAIR VALUE GAP) (+15 Puan)
fvgScore = 0
if direction == 1 and (high[2] < low[0])
    fvgScore := 15
if direction == -1 and (low[2] > high[0])
    fvgScore := 15
if fvgScore > 0
    qualityScore += 15

// 3. RVOL (HACİM SIÇRAMASI) (+15 Puan)
volAvg = ta.sma(volume, 20)
rvol = volume / (volAvg == 0 ? 1 : volAvg)
if rvol >= 1.2
    qualityScore += 15

// 4. ADX TREND GÜCÜ (>25 -> +10 Puan, <20 -> -10 Ceza)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
if adx > 25
    qualityScore += 10
else if adx < 20
    qualityScore -= 10

// 5. KAMA (Kaufman) UYUMU (+5 Puan)
fastAlpha = 2.0 / (2 + 1)
slowAlpha = 2.0 / (30 + 1)
change = math.abs(close - close[10])
volatility = math.sum(math.abs(close - close[1]), 10)
ER = volatility == 0 ? 0 : change / volatility
SC = math.pow(ER * (fastAlpha - slowAlpha) + slowAlpha, 2)
var kama = close
kama := nz(kama[1]) + SC * (close - nz(kama[1]))
if direction == 1 and close > kama
    qualityScore += 5
if direction == -1 and close < kama
    qualityScore += 5

// 6. STOCHASTIC RSI (Aşırı Alım/Satım Cezası -> -10 Puan)
stochRsi = ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14)
if direction == 1 and stochRsi > 80
    qualityScore -= 10
if direction == -1 and stochRsi < 20
    qualityScore -= 10

// 7. ICHIMOKU CLOUD DESTEĞİ (+15 Puan)
conversionLine = math.avg(ta.lowest(9), ta.highest(9))
baseLine = math.avg(ta.lowest(26), ta.highest(26))
leadLine1 = math.avg(conversionLine, baseLine)
leadLine2 = math.avg(ta.lowest(52), ta.highest(52))

if direction == 1 and close > leadLine1[26] and close > leadLine2[26] and conversionLine > baseLine
    qualityScore += 15
if direction == -1 and close < leadLine1[26] and close < leadLine2[26] and conversionLine < baseLine
    qualityScore += 15

// 8. ORDER FLOW DELTA HESABI (+15 / -15 Puan)
buyVol = volume * ((close - low) / (high - low == 0 ? 1 : high - low))
sellVol = volume - buyVol
buyRatio = buyVol / (volume == 0 ? 1 : volume)
sellRatio = sellVol / (volume == 0 ? 1 : volume)

if direction == 1
    if buyRatio > 0.60
        qualityScore += 15
    else if sellRatio > 0.60
        qualityScore -= 15
if direction == -1
    if sellRatio > 0.60
        qualityScore += 15
    else if buyRatio > 0.60
        qualityScore -= 15

// --- V2 GÜNCELLEMESİ: AWS BOT MATEMATİĞİ (PARITY MAPPING) ---

// 9. MULTI-TIMEFRAME: 4H TREND UYUMU (+15 Puan)
sma50_4H = request.security(syminfo.tickerid, "240", ta.sma(close, 50))
currentPrice4H = request.security(syminfo.tickerid, "240", close)
trend4hBull = currentPrice4H > sma50_4H
trend4hBear = currentPrice4H < sma50_4H

if direction == 1
    if trend4hBull
        qualityScore += 15
    else
        qualityScore -= 5
if direction == -1
    if trend4hBear
        qualityScore += 15
    else
        qualityScore -= 5

// 10. MULTI-TIMEFRAME: 1D GOLDEN CROSS (+10 Puan)
sma50_1D = request.security(syminfo.tickerid, "D", ta.sma(close, 50))
sma200_1D = request.security(syminfo.tickerid, "D", ta.sma(close, 200))
currentPrice1D = request.security(syminfo.tickerid, "D", close)

if direction == 1 and sma50_1D > sma200_1D and currentPrice1D > sma200_1D
    qualityScore += 10
if direction == -1 and sma50_1D < sma200_1D and currentPrice1D < sma200_1D
    qualityScore += 10

// 11. RISK / REWARD (R:R) SÜMİLASYONU (+25 Puan)
rrRatio = 0.0
dynamicStop = 0.0
targetP = eq
if direction == 1
    dynamicStop := close - (atrVal * 1.5)
    risk = close - dynamicStop
    reward = targetP - close
    if risk > 0
        rrRatio := reward / risk
if direction == -1
    dynamicStop := close + (atrVal * 1.5)
    risk = dynamicStop - close
    reward = close - targetP
    if risk > 0
        rrRatio := reward / risk

if rrRatio >= 2.0
    qualityScore += 25
else if rrRatio >= 1.2
    qualityScore += 5

// --- D. SONUÇ ÇIKTISI (SIGNAL TRIGGER & VISUALS) ---
isTriggered = qualityScore >= minScore and direction != 0 and rrRatio >= 1.0

// Detaylı Skor Etiketini Grafiğe Bas
if isTriggered
    lblText = (direction == 1 ? "LONG" : "SHORT") + "\nSkor: " + str.tostring(qualityScore) + "\nR:R: " + str.tostring(rrRatio, "#.##")
    if direction == 1
        label.new(bar_index, low - atrVal, lblText, color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_up, size=size.small)
    else
        label.new(bar_index, high + atrVal, lblText, color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

// Arka Plan Renklendirmesi (Gözlem için)
bgcolor(isTriggered and direction == 1 ? color.new(color.green, 90) : na, title="Long Background")
bgcolor(isTriggered and direction == -1 ? color.new(color.red, 90) : na, title="Short Background")

// --- E. ALARM (ALERT) ENTEGRASYONU ---
// Grafikte bu kod eklendikten sonra "Alarm Ekle" menüsünde Elyte Alarmları belirecektir.
alertcondition(isTriggered and direction == 1, title="Elyte LONG Alarmı", message="Elyte LONG Sinyali Tespit Edildi! ({{ticker}})")
alertcondition(isTriggered and direction == -1, title="Elyte SHORT Alarmı", message="Elyte SHORT Sinyali Tespit Edildi! ({{ticker}})")
